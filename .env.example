# ── GCP Photo Restoration Backend ─────────────────────────────────────────────
# The public IP of your GCP Spot VM running server.py.
# Example: http://34.68.200.100:8000
VITE_GCP_BACKEND_URL=http://YOUR_GCP_IP:8000

# ── Hugging Face ───────────────────────────────────────────────────────────────
# Fine-grained token with write access to the dataset repo below.
VITE_HF_ACCESS_TOKEN=hf_YOUR_TOKEN_HERE

# Dataset repo where approved family photos are stored permanently.
# Format: owner/repo-name  (must be a Dataset type, not a Model or Space)
VITE_HF_DATASET_REPO=AIBRUH/robertson-family-album-storage
